{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumiai.local/computer-control/dialog-action-result.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": ["state", "action", "application", "changed", "idempotent", "verified", "verification", "backend"],
  "properties": {
    "state": {"const": "DIALOG_ACTION_COMPLETED"},
    "action": {"enum": ["default", "cancel"]},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "providerId", "available", "running", "active", "bundle"],
      "properties": {
        "name": {"type": "string"},
        "providerId": {"type": "string"},
        "available": {"type": "boolean"},
        "running": {"type": "boolean"},
        "active": {"type": "boolean"},
        "bundle": {"type": ["string", "null"]}
      }
    },
    "changed": {"const": true},
    "idempotent": {"const": false},
    "verified": {"const": true},
    "verification": {"type": "object"},
    "backend": {"type": "object"},
    "diagnostics": {"type": "object"}
  }
}
