{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rumiai.local/computer-control/v0.9/toggle-result.schema.json",
  "title":"Verified stateful boolean control result",
  "type":"object",
  "additionalProperties":false,
  "required":["ok","state","verified","target","requestedValue","previousValue","observedValue","changed","idempotent","verification","backend","diagnostics"],
  "properties":{
    "ok":{"const":true},"state":{"const":"TOGGLED"},"verified":{"const":true},
    "target":{"type":"object","additionalProperties":false,"required":["ref","role","name"],"properties":{"ref":{"type":"string","pattern":"^@e[0-9]+$"},"role":{"enum":["checkbox","switch"]},"name":{"type":"string"}}},
    "requestedValue":{"type":"boolean"},"previousValue":{"type":["boolean","null"]},"observedValue":{"type":"boolean"},"changed":{"type":"boolean"},"idempotent":{"type":"boolean"},
    "verification":{"type":"object"},"backend":{"type":"object"},"diagnostics":{"type":"object"}
  }
}
