{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file-picker-directory-open-result.schema.json",
  "title": "File picker directory open result",
  "type": "object",
  "additionalProperties": true,
  "required": ["state", "application", "directory", "previousLocation", "observedLocation", "picker", "changed", "idempotent", "verified", "verification", "backend"],
  "properties": {
    "state": {"const": "FILE_PICKER_DIRECTORY_OPENED"},
    "application": {"type": "object"},
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"const": "directory"}
      }
    },
    "previousLocation": {"type": "string"},
    "observedLocation": {"type": "string"},
    "picker": {"type": "object"},
    "changed": {"const": true},
    "idempotent": {"const": false},
    "verified": {"const": true},
    "verification": {"type": "object"},
    "backend": {"type": "object"}
  }
}
