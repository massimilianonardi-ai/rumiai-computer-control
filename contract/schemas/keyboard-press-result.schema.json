{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeyboardPressResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "key", "modifiers", "keyLifecycle", "modifierLifecycle", "semanticConsequenceVerified", "verification", "backend"],
  "properties": {
    "state": {"const": "KEY_POSTED"},
    "key": {"enum": ["a", "enter"]},
    "modifiers": {"type": "array", "items": {"const": "shift"}, "maxItems": 1, "uniqueItems": true},
    "keyLifecycle": {"const": "POSTED"},
    "modifierLifecycle": {"enum": ["POSTED", "NOT_REQUIRED"]},
    "semanticConsequenceVerified": {"const": false},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyMethod", "modifierMethod"],
      "properties": {
        "keyMethod": {"const": "quartz-keyboard-event-post-only"},
        "modifierMethod": {"enum": ["quartz-modifier-event-post-only", "not-required"]}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "strategy", "fallback"],
      "properties": {
        "name": {"const": "macos-quartz"},
        "strategy": {"const": "canonical-keyboard-press-post"},
        "fallback": {"const": true}
      }
    },
    "diagnostics": {"type": "object"}
  }
}
