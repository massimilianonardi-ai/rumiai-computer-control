{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://rumiai.local/computer-control/v0.10/children.params.schema.json","title":"Bounded native structure parameters","type":"object","additionalProperties":false,"required":["application","target"],"properties":{"application":{"type":"string","minLength":1},"target":{"type":"object","required":["ref"],"properties":{"ref":{"type":"string","pattern":"^@(e|s)[0-9]+$"}},"additionalProperties":true},"role":{"type":"string","minLength":1},"depth":{"type":"integer","minimum":1,"maximum":12,"default":1},"offset":{"type":"integer","minimum":0,"default":0},"limit":{"type":"integer","minimum":1,"maximum":200,"default":50}}}