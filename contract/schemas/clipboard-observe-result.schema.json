{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumiai.local/computer-control/v0.9/clipboard-observe-result.schema.json",
  "title": "Clipboard metadata observation result",
  "type": "object",
  "required": ["state", "revision", "items", "observation", "backend"],
  "properties": {
    "state": {"const": "OBSERVED"},
    "revision": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "formats", "unsupportedFormatCount"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "formats": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["text/plain", "text/html", "text/rtf", "image/png"]}
          },
          "unsupportedFormatCount": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "observation": {
      "type": "object",
      "required": ["method"],
      "properties": {"method": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": ["name", "strategy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "strategy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "diagnostics": {"type": "object"}
  },
  "additionalProperties": false
}
