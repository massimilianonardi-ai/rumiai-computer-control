{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rumiai.local/computer-control/v0.9/select.params.schema.json",
  "title":"Native selection control parameters",
  "type":"object",
  "additionalProperties":false,
  "required":["application","target"],
  "properties":{
    "application":{"type":"string","minLength":1},
    "target":{"type":"object","required":["ref"],"properties":{"ref":{"type":"string","pattern":"^@e[0-9]+$"}},"additionalProperties":true},
    "settle":{"type":"boolean","default":true}
  }
}
