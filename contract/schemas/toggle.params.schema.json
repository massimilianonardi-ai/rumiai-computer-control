{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rumiai.local/computer-control/v0.9/toggle.params.schema.json",
  "title":"Stateful boolean control parameters",
  "type":"object",
  "additionalProperties":false,
  "required":["application","target","value"],
  "properties":{
    "application":{"type":"string","minLength":1},
    "target":{"type":"object","required":["ref"],"properties":{"ref":{"type":"string","pattern":"^@e[0-9]+$"}},"additionalProperties":true},
    "value":{"type":"boolean"},
    "settle":{"type":"boolean","default":true}
  }
}
