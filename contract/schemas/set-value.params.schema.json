{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://rumiai.local/computer-control/v0.10/set-value.params.schema.json","title":"Set control value parameters","type":"object","additionalProperties":false,"required":["application","target","value"],"properties":{"application":{"type":"string","minLength":1},"target":{"type":"object","required":["ref"],"properties":{"ref":{"type":"string","pattern":"^@e[0-9]+$"}},"additionalProperties":true},"value":{"type":["string","number"]},"settle":{"type":"boolean","default":true}}}