{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://rumiai.local/computer-control/v0.10/scroll.params.schema.json","title":"Semantic scroll parameters","type":"object","additionalProperties":false,"required":["application","target","direction"],"properties":{"application":{"type":"string","minLength":1},"target":{"type":"object","required":["ref"],"properties":{"ref":{"type":"string","pattern":"^@e[0-9]+$"}},"additionalProperties":true},"direction":{"enum":["up","down"]},"amount":{"type":"integer","minimum":1,"maximum":10,"default":1},"settle":{"type":"boolean","default":true}}}