{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumiai.local/computer-control/v0.10/display-capture-result.schema.json",
  "title": "Display capture result",
  "type": "object",
  "required": ["state", "display", "format", "width", "height", "byteCount", "dataBase64", "cursorIncluded", "observation", "backend"],
  "properties": {
    "state": {"const": "CAPTURED"},
    "display": {"const": "primary"},
    "format": {"const": "image/png"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "byteCount": {"type": "integer", "minimum": 1, "maximum": 20971520},
    "dataBase64": {"type": "string", "contentEncoding": "base64"},
    "cursorIncluded": {"const": false},
    "observation": {
      "type": "object",
      "required": ["method"],
      "properties": {"method": {"const": "macos-screencapturekit-primary-display-png"}},
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": ["name", "strategy"],
      "properties": {
        "name": {"const": "macos-screencapturekit"},
        "strategy": {"const": "primary-display-single-frame-png"}
      },
      "additionalProperties": false
    },
    "diagnostics": {"type": "object"}
  },
  "additionalProperties": false
}
