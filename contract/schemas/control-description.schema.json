{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumiai.local/computer-control/v0.9/control-description.schema.json",
  "title": "Normalized control description",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state", "target", "description", "value", "valueType", "visible",
    "enabled", "focused", "selected", "checked", "mixed", "expanded",
    "readOnly", "required", "range", "actions", "childCount", "parentRole",
    "bounds", "observation", "backend"
  ],
  "properties": {
    "state": {"const": "DESCRIBED"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "role", "name"],
      "properties": {
        "ref": {"type": "string", "pattern": "^@e[0-9]+$"},
        "role": {"$ref": "#/$defs/controlRole"},
        "name": {"type": "string"}
      }
    },
    "description": {"type": ["string", "null"]},
    "value": {"type": ["string", "number", "boolean", "null"]},
    "valueType": {
      "enum": ["null", "string", "number", "boolean", "date", "time", "date-time"]
    },
    "visible": {"type": ["boolean", "null"]},
    "enabled": {"type": ["boolean", "null"]},
    "focused": {"type": ["boolean", "null"]},
    "selected": {"type": ["boolean", "null"]},
    "checked": {"type": ["boolean", "null"]},
    "mixed": {"type": ["boolean", "null"]},
    "expanded": {"type": ["boolean", "null"]},
    "readOnly": {"type": ["boolean", "null"]},
    "required": {"type": ["boolean", "null"]},
    "range": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "step", "value"],
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"},
            "step": {"type": ["number", "null"]},
            "value": {"type": "number"}
          }
        }
      ]
    },
    "actions": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/controlAction"}
        }
      ]
    },
    "childCount": {"type": ["integer", "null"], "minimum": 0},
    "parentRole": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/controlRole"}
      ]
    },
    "bounds": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "width": {"type": "number", "minimum": 0},
            "height": {"type": "number", "minimum": 0}
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {"method": {"type": "string", "minLength": 1}}
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "strategy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "strategy": {"type": "string", "minLength": 1}
      }
    },
    "diagnostics": {"type": "object"}
  },
  "$defs": {
    "controlRole": {
      "enum": [
        "application", "window", "dialog", "alert", "group", "generic", "region",
        "toolbar", "toolbar-item", "menu-bar", "menu", "menu-item", "button", "link",
        "checkbox", "switch", "radio-button", "combo-box", "list",
        "list-item", "option", "slider", "spin-button", "text-field",
        "text-area", "search-box", "static-text", "date", "time", "date-time",
        "tab-list", "tab", "tree", "tree-item", "table", "row", "column",
        "cell", "header", "scroll-area", "progress-bar", "image", "separator",
        "unknown"
      ]
    },
    "controlAction": {
      "enum": [
        "focus", "click", "set-text", "clear", "invoke", "toggle", "select",
        "set-value", "expand", "collapse", "increment", "decrement", "scroll",
        "scroll-into-view"
      ]
    }
  }
}
