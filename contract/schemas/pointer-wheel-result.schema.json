{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PointerWheelResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "display", "position", "direction", "amount", "positionVerified", "wheelDelivery", "semanticConsequenceVerified", "verification", "backend"],
  "properties": {
    "state": {"const": "WHEEL_POSTED"},
    "display": {"const": "primary"},
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {"x": {"type": "number", "minimum": 0}, "y": {"type": "number", "minimum": 0}}
    },
    "direction": {"enum": ["up", "down"]},
    "amount": {"type": "integer", "minimum": 1, "maximum": 10},
    "positionVerified": {"const": true},
    "wheelDelivery": {"const": "POSTED"},
    "semanticConsequenceVerified": {"const": false},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positionMethod", "wheelMethod"],
      "properties": {
        "positionMethod": {"const": "quartz-current-pointer-location"},
        "wheelMethod": {"const": "quartz-event-post-only"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "strategy", "fallback"],
      "properties": {"name": {"const": "macos-quartz"}, "strategy": {"const": "primary-display-pointer-wheel-post"}, "fallback": {"const": true}}
    },
    "diagnostics": {"type": "object"}
  }
}
