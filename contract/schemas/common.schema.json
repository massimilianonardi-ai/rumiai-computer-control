{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumiai.local/computer-control/v0.1/common.schema.json",
  "title": "RumiAI Computer Control common types",
  "$defs": {
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "recoveryPolicy": {
      "type": "string",
      "enum": ["NONE", "CALLER_DECIDES", "SAFE_RETRY"]
    },
    "validationState": {
      "type": "string",
      "enum": ["PROPOSED", "BOUNDARY_PASS", "PHYSICALLY_VALIDATED", "PROMOTED", "RELEASED"]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "available", "validationState"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "validationState": { "$ref": "#/$defs/validationState" },
        "strategies": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "recoveryPolicy"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string" },
        "recoveryPolicy": { "$ref": "#/$defs/recoveryPolicy" },
        "details": { "type": "object" }
      }
    }
  }
}
