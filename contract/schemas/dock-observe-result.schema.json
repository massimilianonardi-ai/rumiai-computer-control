{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rumiai.local/schemas/dock-observe-result.schema.json",
  "title": "dock.observe result",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "dock", "observation", "backend"],
  "properties": {
    "state": {"const": "OBSERVED"},
    "dock": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "title", "running", "status"],
                "properties": {
                  "kind": {"enum": ["application", "folder", "trash", "separator", "other"]},
                  "title": {"type": ["string", "null"]},
                  "running": {"type": ["boolean", "null"]},
                  "status": {"type": ["string", "null"]}
                }
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {"method": {"type": "string", "minLength": 1}}
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "strategy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "strategy": {"type": "string", "minLength": 1}
      }
    },
    "diagnostics": {"type": "object"}
  }
}
