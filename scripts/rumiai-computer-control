#!/bin/sh

set -eu

SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname "$SELF")/.." && pwd)"
NODE_BIN="${RUMIAI_CC_NODE:-$(command -v node || true)}"

case "${1:-}" in
  adapter-path)
    echo "$ROOT/adapters/rumiai/compat.js"
    ;;
  home)
    echo "$ROOT"
    ;;
  runtime)
    [ -n "$NODE_BIN" ] || { echo "Node.js 20 or newer is required." >&2; exit 2; }
    exec "$NODE_BIN" "$ROOT/runtime/src/cli.js"
    ;;
  doctor)
    [ -n "$NODE_BIN" ] || { echo "Node.js 20 or newer is required." >&2; exit 2; }
    "$NODE_BIN" -e 'const major=Number(process.versions.node.split(".")[0]); if(major<20) process.exit(2)'
    test -x "$ROOT/backends/macos/runtime/bin/agent-ctrl"
    "$ROOT/backends/macos/runtime/bin/agent-ctrl" --version
    echo "rumiai-computer-control=PASS"
    ;;
  *)
    echo "Usage: rumiai-computer-control {adapter-path|home|runtime|doctor}" >&2
    exit 2
    ;;
esac
